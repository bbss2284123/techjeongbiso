---
import type { CollectionEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Card from "./Card.astro";
import Shot from "./mdx/Shot.astro";
import Marker from "./mdx/Marker.astro";
import Arrow from "./mdx/Arrow.astro";
import HighlightBox from "./mdx/HighlightBox.astro";
import Callout from "./mdx/Callout.astro";
import AdSlot from "./mdx/AdSlot.astro";
import Term from "./mdx/Term.astro";
import { categoryById, siteConfig, absoluteUrl } from "../../site.config";
import { authorName, postPath } from "../lib/posts";
import { formatDot } from "../lib/dates";
import { headingSlug } from "../lib/slug";

interface Props {
  post: CollectionEntry<"posts">;
  Content: any;
  related: CollectionEntry<"posts">[];
}
const { post, Content, related } = Astro.props;
const category = categoryById(post.data.category);
const toc = [...(post.body ?? "").matchAll(/^##\s+(.+)$/gm)].map((match) => match[1].trim());
const url = absoluteUrl(post.data.draft ? `/draft/${post.id}/` : postPath(post.id));
const quickAnswer = post.data.quickAnswer;
const appLine = post.data.appVersion === post.data.app || post.data.appVersion === "해당 없음"
  ? post.data.app
  : `${post.data.app} ${post.data.appVersion}`;
const sourceNote = "아래는 이 글에서 참고한 공식 문서입니다.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date,
    dateModified: post.data.updated,
    author: { "@type": "Person", name: authorName(post) },
    publisher: { "@type": "Organization", name: siteConfig.name, url: siteConfig.url },
    mainEntityOfPage: url,
    image: absoluteUrl(post.data.heroImage),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "홈", item: siteConfig.url },
      { "@type": "ListItem", position: 2, name: category?.name, item: absoluteUrl(`/category/${post.data.category}/`) },
      { "@type": "ListItem", position: 3, name: post.data.title, item: url },
    ],
  },
  ...(post.data.verification !== "미검증"
    ? [{
        "@context": "https://schema.org",
        "@type": "HowTo",
        name: post.data.title,
        step: post.data.steps.map((step, index) => ({
          "@type": "HowToStep",
          position: index + 1,
          name: step.title,
          text: step.body,
        })),
      }]
    : []),
];
---
<Base
  title={post.data.title}
  description={post.data.description}
  path={post.data.draft ? `/draft/${post.id}/` : postPath(post.id)}
  ogImage={`/thumb/posts/${post.id}/og.png`}
  type="article"
  published={post.data.date}
  modified={post.data.updated}
  current={post.data.category}
  noindex={post.data.draft}
  jsonLd={jsonLd}
>
  <article id="content" class="wrap article" data-cat={post.data.category} data-pagefind-body style={`--accent:${category?.accent ?? siteConfig.design.blue};--soft:${category?.soft ?? "#EAF2FF"}`}>
    <nav class="crumbs" aria-label="경로">
      <a href="/">홈</a><span>/</span>
      <a href={`/category/${post.data.category}/`}>{category?.name}</a>
    </nav>
    <div class="kicker">
      <a class="cat-pill" href={`/category/${post.data.category}/`}>{category?.name}</a>
    </div>
    <h1>{post.data.title}</h1>
    <section class="symptom">
      <strong>증상 요약</strong>
      <p>{post.data.symptoms}</p>
    </section>
    <section class="easiest">
      <strong>가장 빠른 해결</strong>
      <p>{quickAnswer}</p>
    </section>
    <dl class="env-grid">
      <div class="env-cell"><dt>기기</dt><dd>{post.data.device}</dd></div>
      <div class="env-cell"><dt>OS · 버전</dt><dd>{post.data.os}</dd></div>
      <div class="env-cell"><dt>앱 · 버전</dt><dd>{appLine}</dd></div>
    </dl>
    <figure class="hero-figure">
      <img src={post.data.heroImage} alt={`${post.data.title} 대표 이미지`} width="1200" height="675" />
      <figcaption>분류 배경 위에 제목을 올린 대표 이미지입니다. 오류 화면이 아닙니다.</figcaption>
    </figure>
    {post.data.dataLossRisk && (
      <aside class="callout callout-warn"><p>이 절차는 데이터 삭제나 초기화로 이어질 수 있습니다. 시작 전에 백업하세요.</p></aside>
    )}
    {post.data.category === "car" && (
      <aside class="callout callout-danger"><p>제동, 조향, 에어백처럼 주행 안전과 연결된 증상은 이 글의 순서로 직접 고치지 말고 제조사 점검을 받으세요.</p></aside>
    )}
    {toc.length > 0 && (
      <nav class="toc" aria-label="차례">
        <strong>이 글의 순서</strong>
        <ol>
          {toc.map((item) => <li><a href={`#${headingSlug(item)}`}>{item}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose">
      <Content components={{ Shot, Marker, Arrow, HighlightBox, Callout, AdSlot, Term }} />
    </div>
    <section class="sources">
      <h2>출처</h2>
      <p>{sourceNote}</p>
      <ul>
        {post.data.sources.map((source) => (
          <li><a href={source.url} rel="noopener noreferrer">{source.title}</a></li>
        ))}
      </ul>
    </section>
    <section class="related">
      <h2>관련 글</h2>
      {related.length === 0 ? <p>같은 분류의 발행 글이 아직 없습니다.</p> : (
        <div class="related-grid">
          {related.map((item) => (
            <Card
              href={postPath(item.id)}
              title={item.data.title}
              date={formatDot(item.data.date)}
              category={item.data.category}
              image={`/thumb/posts/${item.id}/card.png`}
              alt={`${item.data.title} 대표 이미지`}
            />
          ))}
        </div>
      )}
    </section>
  </article>
  <dialog id="lightbox" class="lightbox">
    <div class="lightbox-bar">
      <button type="button" data-zoom="in">크게</button>
      <button type="button" data-zoom="out">작게</button>
      <button type="button" data-zoom="close">닫기</button>
    </div>
    <div class="lightbox-scroll"><img alt="" /></div>
  </dialog>
  <script is:inline>
    const dialog = document.querySelector("#lightbox");
    const img = dialog?.querySelector("img");
    let scale = 1;
    function paint() {
      if (!img) return;
      img.style.width = scale <= 1 ? "min(1200px, 100%)" : `${Math.round(scale * 100)}%`;
      img.style.maxWidth = scale <= 1 ? "100%" : "none";
    }
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element) || !dialog || !img) return;
      const open = target.closest(".shot-open");
      if (open instanceof HTMLElement) {
        img.src = open.dataset.full || "";
        img.alt = open.dataset.alt || "";
        scale = 1;
        paint();
        dialog.showModal();
      }
      if (target.closest("[data-zoom='in']")) { scale = Math.min(2.4, scale + 0.4); paint(); }
      if (target.closest("[data-zoom='out']")) { scale = Math.max(1, scale - 0.4); paint(); }
      if (target.closest("[data-zoom='close']")) dialog.close();
    });
    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  </script>
</Base>
