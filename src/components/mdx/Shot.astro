---
interface Props {
  id?: string;
  src: string;
  alt: string;
  caption?: string;
  type?: "capture" | "reproduction";
  badge?: boolean;
}
const { src, alt, caption = "", type = "capture" } = Astro.props;
---
<figure class={`shot shot-${type}`}>
  <div class="shot-stage">
    <button class="shot-open" type="button" data-full={src} data-alt={alt} aria-label={`${alt} 크게 보기`}>
      <img src={src} alt={alt} loading="lazy" />
    </button>
    <slot />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
