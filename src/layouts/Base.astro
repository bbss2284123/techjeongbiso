---
import "../styles/global.css";
import { siteConfig, absoluteUrl } from "../../site.config";
import Seo from "../components/Seo.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: "website" | "article";
  jsonLd?: unknown[];
  published?: string;
  modified?: string;
  current?: string;
  noindex?: boolean;
}
const { title, description, path, ogImage, type = "website", jsonLd = [], published, modified, current = "", noindex = false } = Astro.props;
const canonical = absoluteUrl(path);
---
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/brand/symbol.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={siteConfig.design.blue} />
    <link rel="preload" href="/fonts/pretendard/Pretendard-Regular.subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pretendard/Pretendard-ExtraBold.subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/pretendard/pretendard.css" />
    <Seo title={title} description={description} canonical={canonical} ogImage={ogImage} type={type} published={published} modified={modified} jsonLd={jsonLd} noindex={noindex} />
  </head>
  <body>
    <a class="skip" href="#content">본문으로</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <img src="/brand/logo-horizontal-light.png" alt="테크정비소" width="980" height="180" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">메뉴</button>
        <nav id="site-menu" class="nav-links" aria-label="주요">
          <a class:list={["nav-home", { "is-on": current === "home" }]} href="/" aria-current={current === "home" ? "page" : undefined}>홈</a>
          {siteConfig.categories.map((category) => (
            <div class="nav-drop">
              <a class:list={["nav-link", { "is-current": current === category.id }]} href={`/category/${category.id}/`}>
                {category.name}
                <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              </a>
              <div class="nav-panel">
                <p>{category.description}</p>
                {category.topics.map((topic) => (
                  <a href={`/search/?q=${encodeURIComponent(topic.q)}`}>{topic.label}</a>
                ))}
              </div>
            </div>
          ))}
        </nav>
        <div class="header-tools">
          <button class="icon-btn" type="button" data-open-search aria-label="검색">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-inner">
        <img src="/brand/logo-horizontal-dark.png" alt="테크정비소" width="980" height="180" />
        <p>{siteConfig.tagline}</p>
        <nav class="footer-links" aria-label="정책">
          <a href="/about/">소개</a>
          <a href="/author/">글쓴이</a>
          <a href="/privacy/">개인정보처리방침</a>
          <a href="/terms/">이용약관</a>
          <a href="/contact/">문의</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <p class="legal">© {new Date().getFullYear()} techjeongbiso.com</p>
      </div>
    </footer>
    <dialog id="search-dialog" class="search-dialog">
      <form action="/search/" method="get">
        <h2>검색</h2>
        <input type="search" name="q" placeholder="궁금한 내용을 검색해보세요" aria-label="검색어" />
        <button class="btn-blue" type="submit">검색</button>
      </form>
    </dialog>
    <dialog id="bookmark-dialog" class="modal">
      <h2>즐겨찾기에 추가하는 방법</h2>
      <p>사이트에서 브라우저 즐겨찾기를 대신 저장하지는 않습니다. 쓰는 브라우저에서 아래처럼 저장하세요.</p>
      <ol>
        <li>Windows의 Chrome, Edge, Firefox: Ctrl + D</li>
        <li>Mac의 Chrome, Edge, Firefox, Safari: Command + D</li>
        <li>iPhone Safari: 공유 버튼 후 즐겨찾기에 추가</li>
        <li>Android Chrome: 메뉴에서 별표 또는 즐겨찾기</li>
        <li>삼성 인터넷: 아래쪽 별표</li>
      </ol>
      <button class="text-btn" type="button" data-close-bookmark>닫기</button>
    </dialog>
    <script is:inline>
      const menuButton = document.querySelector(".menu-toggle");
      const menu = document.querySelector("#site-menu");
      menuButton?.addEventListener("click", () => {
        const open = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!open));
        menu?.classList.toggle("is-open", !open);
      });
      const searchDialog = document.querySelector("#search-dialog");
      document.querySelector("[data-open-search]")?.addEventListener("click", () => {
        searchDialog?.showModal();
        searchDialog?.querySelector("input")?.focus();
      });
      const bookmarkDialog = document.querySelector("#bookmark-dialog");
      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("[data-open-bookmark]")) bookmarkDialog?.showModal();
        if (target.closest("[data-close-bookmark]")) bookmarkDialog?.close();
      });
      for (const dialog of [searchDialog, bookmarkDialog]) {
        dialog?.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      }
    </script>
  </body>
</html>
