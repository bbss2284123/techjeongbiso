---
import Base from "../layouts/Base.astro";
import { siteConfig } from "../../site.config";
---
<Base title="문의" description="테크정비소 문의" path="/contact/">
  <main id="content" class="wrap page-narrow" data-pagefind-body>
    <h1>문의</h1>
    <p>틀린 화면이나 바뀐 메뉴를 알려 주시면 확인 날짜를 다시 적습니다.</p>
    <p><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></p>
  </main>
</Base>
